# Copy to .env (git-ignored). Process environment overrides these values.

# Matches deploy/compose.yml defaults; change POSTGRES_PASSWORD for anything non-local.
TB_DATABASE__URL=postgres://bot:bot@localhost:5432/tradingbot?sslmode=disable

# API keys: trade permission only, NO withdraw, IP whitelist. Separate keys per testnet/live.
TB_EXCHANGES__BINANCE__API_KEY=
TB_EXCHANGES__BINANCE__API_SECRET=
TB_EXCHANGES__BYBIT__API_KEY=
TB_EXCHANGES__BYBIT__API_SECRET=
TB_EXCHANGES__OKX__API_KEY=
TB_EXCHANGES__OKX__API_SECRET=
TB_EXCHANGES__OKX__PASSPHRASE=
TB_TELEGRAM__TOKEN=
TB_WEB__PASSWORD=
