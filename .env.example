# Copy to .env (git-ignored). Process environment overrides these values.

# Matches deploy/compose.yml defaults; change POSTGRES_PASSWORD for anything non-local.
TB_DATABASE__URL=postgres://bot:bot@localhost:5432/tradingbot?sslmode=disable

# API keys: trade permission only, NO withdraw, IP whitelist. Separate keys per testnet/live.
# Paper wallets need no keys (public prices only).

# Binance Spot Testnet (https://testnet.binance.vision, login GitHub,
# "Generate HMAC_SHA256 Key"). Used by wallets with mode: testnet.
TB_EXCHANGES__BINANCE__TESTNET_API_KEY=
TB_EXCHANGES__BINANCE__TESTNET_API_SECRET=

# Binance LIVE (real money, binance.com API Management). Used only by wallets
# with mode: live plus app.allow_live and wallets[].allow_live. Leave empty.
TB_EXCHANGES__BINANCE__API_KEY=
TB_EXCHANGES__BINANCE__API_SECRET=
TB_TELEGRAM__TOKEN=
TB_WEB__PASSWORD=
