# Dedicated Plan 3 environment. Keep the filled .env.catalyst out of Git.
# Use HTTPS; do not send API keys over the public HTTP endpoint.
TB_CATALYST_BASE_URL=https://route-gateway.fbe.co.id/v1

# Fill the OmniRoute API key here, never in chat or a committed file.
TB_CATALYST_API_KEY=

# Pilot only: separate role/database and dashboard; never use the P2 database.
TB_CATALYST_DATABASE_URL=
TB_CATALYST_WEB_PASSWORD=
# Optional sender only; shares no long-poller or command menu with P2.
TB_CATALYST_TELEGRAM_TOKEN=
TB_CATALYST_TELEGRAM_CHATS=

# Selected from the synthetic evaluation; see docs/testing/catalyst-model-evaluation.md.
# After creating and testing the priority combo, its exact name can replace this ID.
TB_CATALYST_MODEL=cx/gpt-6-luna-low
