# Built by .github/workflows/spider.yml from Dockerfile.spider; bump the digest only
# after a new Spider version is published. Local builds may override this arg.
ARG SPIDER_IMAGE=ghcr.io/rizz404/trading-bot-spider@sha256:480faea43abdb2b2e8bd6cf136ecd250e8c37039e925f0bdb38f14385a318e19
FROM ${SPIDER_IMAGE} AS spider

FROM docker.io/library/golang:1.27.2-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/catalyst ./cmd/catalyst
COPY internal ./internal
COPY migrations ./migrations
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/catalyst ./cmd/catalyst

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/catalyst && chown 65532:65532 /var/lib/catalyst
WORKDIR /app
COPY --from=spider /spider /usr/local/bin/spider
COPY --from=build /out/catalyst /app/catalyst
COPY configs/catalyst.policy.json /app/configs/catalyst.policy.json
USER 65532:65532
ENTRYPOINT ["/app/catalyst"]
CMD ["-action", "report", "-archive", "/var/lib/catalyst"]
