package views

import "github.com/rizz404/crypto-launch-bot/internal/ui"

templ Overview(st Status) {
	@Layout("Ringkasan", "overview") {
		@ui.Heading("Ringkasan sesi", "Status akun, posisi terbuka, order, dan trade terbaru.", nil)
		@StatusPanel(st)
		if st.Live {
			@ui.Card("Equity (sesi ini)", nil) {
				<div class="h-72 w-full" data-chart="line" data-src="/api/equity"></div>
			}
			@ui.CardFlush("Posisi terbuka", nil) {
				<div hx-get="/partials/positions" hx-trigger="load, every 5s"><p class="p-5 text-muted">Memuat…</p></div>
			}
			@ui.CardFlush("Order terbuka", nil) {
				<div hx-get="/partials/orders" hx-trigger="load, every 10s"><p class="p-5 text-muted">Memuat…</p></div>
			}
		}
		@ui.CardFlush("Trade terbaru", nil) {
			<div hx-get="/partials/trades" hx-trigger="load, every 30s"><p class="p-5 text-muted">Memuat…</p></div>
		}
	}
}

templ StatusPanel(st Status) {
	<div id="status" class="space-y-4" hx-get="/partials/status" hx-trigger="every 5s" hx-swap="outerHTML">
		if !st.Live {
			@ui.Alert("info") {
				Tidak ada sesi trading yang berjalan: bot hanya merekam data pasar.
			}
		} else {
			@ui.StatGrid() {
				@ui.Stat("Mode", st.Mode, "", "")
				@ui.Stat("Equity", st.Equity, "", "")
				@ui.Stat("Unrealized", st.Unrealized, tone(st.UnrealizedPos), "")
				@ui.Stat("Eksposur", st.Exposure, "", "")
				@ui.Stat("Posisi", itoa(st.OpenPositions), "", "")
				if st.Killed {
					@ui.Stat("Status", "KILL SWITCH", "neg", st.KillReason)
				} else if st.Paused {
					@ui.Stat("Status", "Ditahan", "warn", "entri baru ditahan")
				} else {
					@ui.Stat("Status", "Berjalan", "pos", "")
				}
			}
			if st.Killed {
				@ui.Alert("neg") {
					<strong>Kill switch aktif:</strong> { st.KillReason }
				}
			}
			<div class="flex flex-wrap gap-2">
				if st.Paused && !st.Killed {
					<button class={ ui.BtnPrimary } hx-post="/actions/resume" hx-target="#status" hx-swap="outerHTML">Lanjutkan entri</button>
				} else if !st.Paused {
					<button class={ ui.BtnSecondary } hx-post="/actions/pause" hx-target="#status" hx-swap="outerHTML">Tahan entri</button>
				}
				if st.Killed {
					<button
						class={ ui.BtnPrimary }
						hx-post="/actions/reset"
						hx-target="#status"
						hx-swap="outerHTML"
						data-confirm="Hapus kill switch dan lanjutkan trading?"
						data-confirm-body="Bot akan boleh membuka posisi baru lagi."
						data-confirm-label="Reset kill switch"
					>Reset kill switch</button>
				} else {
					<button
						class={ ui.BtnDanger }
						hx-post="/actions/kill"
						hx-target="#status"
						hx-swap="outerHTML"
						data-confirm="Tutup SEMUA posisi dan hentikan trading?"
						data-confirm-body="Semua posisi ditutup dan trading berhenti sampai kill switch di-reset."
						data-confirm-label="Kill switch"
						data-confirm-tone="danger"
					>Kill switch</button>
				}
			</div>
			@ui.CardFlush("Akun", nil) {
				@ui.Table() {
					<thead><tr><th>Akun</th><th>Saldo</th><th>Equity</th><th>Unrealized</th><th>Margin bebas</th><th>Posisi</th></tr></thead>
					<tbody>
						for _, a := range st.Accounts {
							<tr><td>{ a.Key }</td><td>{ a.Balance }</td><td>{ a.Equity }</td><td>{ a.Unrealized }</td><td>{ a.FreeMargin }</td><td>{ itoa(a.Positions) }</td></tr>
						}
					</tbody>
				}
			}
		}
	</div>
}

templ Positions(rows []PositionRow) {
	if len(rows) == 0 {
		@ui.Empty("Tidak ada posisi terbuka.")
	} else {
		@ui.Table() {
			<thead><tr><th>Akun</th><th>Simbol</th><th>Sisi</th><th>Qty</th><th>Entry</th><th>Mark</th><th>uPnL</th><th>Strategi</th><th>Dibuka</th></tr></thead>
			<tbody>
				for _, p := range rows {
					<tr>
						<td>{ p.Account }</td>
						<td><a class={ ui.LinkClass } href={ templ.SafeURL(p.ChartHref) }>{ p.Symbol }</a></td>
						<td>{ p.Side }</td><td>{ p.Qty }</td><td>{ p.Entry }</td><td>{ p.Mark }</td>
						<td class={ ui.Tone(tone(p.UPnLPositive)) }>{ p.UPnL }</td>
						<td>{ p.Strategy }</td><td>{ p.Opened }</td>
					</tr>
				}
			</tbody>
		}
	}
}

templ Orders(rows []OrderRow) {
	if len(rows) == 0 {
		@ui.Empty("Tidak ada order terbuka.")
	} else {
		@ui.Table() {
			<thead><tr><th>Simbol</th><th>Sisi</th><th>Tipe</th><th>Tag</th><th>Qty</th><th>Harga</th><th>Strategi</th><th>Status</th><th>Dibuat</th></tr></thead>
			<tbody>
				for _, o := range rows {
					<tr><td>{ o.Symbol }</td><td>{ o.Side }</td><td>{ o.Type }</td><td>{ o.Tag }</td><td>{ o.Qty }</td><td>{ o.Price }</td><td>{ o.Strategy }</td><td>{ o.Status }</td><td>{ o.Created }</td></tr>
				}
			</tbody>
		}
	}
}

templ Trades(rows []TradeRow) {
	if len(rows) == 0 {
		@ui.Empty("Belum ada trade.")
	} else {
		@ui.Table() {
			<thead><tr><th>Ditutup</th><th>Strategi</th><th>Simbol</th><th>Sisi</th><th>Qty</th><th>Entry</th><th>Exit</th><th>PnL bersih</th><th>Fee</th><th>Alasan keluar</th></tr></thead>
			<tbody>
				for _, t := range rows {
					<tr>
						<td>{ t.Closed }</td><td>{ t.Strategy }</td>
						<td><a class={ ui.LinkClass } href={ templ.SafeURL(t.ChartHref) }>{ t.Symbol }</a></td>
						<td>{ t.Side }</td><td>{ t.Qty }</td><td>{ t.Entry }</td><td>{ t.Exit }</td>
						<td class={ ui.Tone(tone(t.Win)) }>{ t.Net }</td>
						<td>{ t.Fees }</td><td>{ t.Reason }</td>
					</tr>
				}
			</tbody>
		}
	}
}
