package views

templ Layout(title, nav string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } · trading-bot</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/lightweight-charts.js"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<header>
				<span class="brand">trading-bot</span>
				<nav>
					<a href="/" class={ templ.KV("active", nav == "overview") }>Overview</a>
					<a href="/chart" class={ templ.KV("active", nav == "chart") }>Chart</a>
					<a href="/backtests" class={ templ.KV("active", nav == "backtests") }>Backtests</a>
				</nav>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

templ Empty(msg string) {
	<p class="muted">{ msg }</p>
}
