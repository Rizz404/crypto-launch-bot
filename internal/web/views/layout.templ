package views

import "github.com/rizz404/trading-bot/internal/ui"

func page(title, nav string) ui.Page {
	return ui.Page{
		Title:  title,
		Brand:  "trading-bot",
		Active: nav,
		Nav: []ui.NavItem{
			{Key: "overview", Label: "Ringkasan", Href: "/"},
			{Key: "chart", Label: "Grafik", Href: "/chart"},
			{Key: "backtests", Label: "Backtest", Href: "/backtests"},
		},
		Footer: "Dashboard sesi bot · data diperbarui otomatis",
		Charts: true,
	}
}

func tone(positive bool) string {
	if positive {
		return "pos"
	}
	return "neg"
}

templ Layout(title, nav string) {
	@ui.Shell(page(title, nav)) {
		{ children... }
	}
}
