package views

import "github.com/rizz404/crypto-launch-bot/internal/ui"

const pillClass = "rounded-full border border-outline px-3 py-1 text-xs font-medium text-on-surface transition-colors hover:bg-surface-alt aria-[current=page]:border-primary aria-[current=page]:bg-badge aria-[current=page]:text-on-badge"

templ Chart(p ChartPage) {
	@Layout("Grafik", "chart") {
		@ui.Heading("Grafik harga", "Candle dengan penanda entry dan exit trade.", nil)
		@ui.Card("", nil) {
			<form method="get" action="/chart" class="max-w-md" hx-get="/chart" hx-trigger="change" hx-target="body" hx-swap="innerHTML" hx-push-url="true">
				@ui.Field("Seri (bursa:pasar:simbol:timeframe)") {
					<select name="series" class={ ui.InputClass }>
						for _, s := range p.Series {
							<option value={ s.Href } selected?={ s.Href == p.Selected }>{ s.Label }</option>
						}
					</select>
				}
			</form>
			if len(p.Timeframes) > 1 {
				<div class="mt-3 flex flex-wrap gap-2" aria-label="Timeframe">
					for _, tf := range p.Timeframes {
						<a class={ pillClass } href={ templ.SafeURL(tf.Href) } aria-current={ ui.Current(tf.Active) }>{ tf.Label }</a>
					}
				</div>
			}
			if p.Note != "" {
				<p class="mt-3 text-muted">{ p.Note }</p>
			}
		}
		if p.Src != "" {
			@ui.Card("", nil) {
				<div class="h-[32rem] w-full max-sm:h-96" data-chart="candles" data-src={ p.Src }></div>
				<p class="mt-3 text-xs text-muted">Panah menandai entry (▲ long, ▼ short) dan exit.</p>
			}
		}
	}
}

templ Backtests(rows []RunRow) {
	@Layout("Backtest", "backtests") {
		@ui.Heading("Backtest tersimpan", "Disimpan dengan perintah backtest -save.", nil)
		@ui.CardFlush("", nil) {
			if len(rows) == 0 {
				@ui.Empty("Belum ada backtest tersimpan.")
			} else {
				@ui.Table() {
					<thead><tr><th>#</th><th>Strategi</th><th>Simbol</th><th>Segmen</th><th>Periode</th><th>Return</th><th>Max DD</th><th>Sharpe</th><th>Trade</th><th>Win rate</th><th>PF</th></tr></thead>
					<tbody>
						for _, r := range rows {
							<tr>
								<td><a class={ ui.LinkClass } href={ templ.SafeURL(r.Href) }>{ itoa64(r.ID) }</a></td>
								<td>{ r.Instance }</td><td>{ r.Symbols }</td><td>{ r.Segment }</td><td>{ r.Period }</td>
								<td class={ ui.Tone(tone(r.Positive)) }>{ r.Return }</td>
								<td>{ r.MaxDD }</td><td>{ r.Sharpe }</td><td>{ r.Trades }</td><td>{ r.WinRate }</td><td>{ r.ProfitFactor }</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}

templ Backtest(d RunDetail) {
	@Layout("Backtest", "backtests") {
		@ui.Heading("Backtest #"+itoa64(d.Run.ID)+" · "+d.Run.Instance, d.Run.Symbols+" · "+d.Run.Segment+" · "+d.Run.Period, nil)
		<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
			for _, m := range d.Metrics {
				@ui.Stat(m[0], m[1], "", "")
			}
		</div>
		@ui.Card("Equity", nil) {
			<div class="h-72 w-full" data-chart="line" data-src={ d.EquitySrc }></div>
		}
		if len(d.Charts) > 0 {
			@ui.Card("Grafik dengan trade", nil) {
				<div class="flex flex-wrap gap-2">
					for _, c := range d.Charts {
						<a class={ pillClass } href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
					}
				</div>
			}
		}
		@ui.Card("Parameter", nil) {
			<pre class="overflow-x-auto whitespace-pre-wrap rounded-lg bg-surface-alt p-4 font-mono text-xs">{ d.Params }</pre>
		}
		@ui.CardFlush("Trade", nil) {
			@Trades(d.Trades)
		}
	}
}
