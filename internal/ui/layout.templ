package ui

// Page describes the shell around a surface (bot dashboard, managed, catalyst).
type Page struct {
	Title  string
	Brand  string
	Active string
	Nav    []NavItem
	Footer string
	// Charts loads lightweight-charts; only pages with data-chart elements need it.
	Charts bool
	// Wide uses the full screen width (trading screen).
	Wide bool
	// Sidebar replaces the header links with a left menu (managed dashboard);
	// SideFoot is rendered at its bottom (account links).
	Sidebar  []NavGroup
	SideFoot templ.Component
	// Currency shows the USD/IDR switcher for [data-fiat] amounts.
	Currency bool
	// Notice is shown once as a toast; NoticeTone "pos" or "neg".
	Notice, NoticeTone string
}

// NavGroup is a block of sidebar links. A Collapsible group is a native
// <details> sub menu (no script), expanded when Open; a group without a
// Title renders its items as top-level links.
type NavGroup struct {
	Title       string
	Items       []NavItem
	Collapsible bool
	Open        bool
}

// width is the content width shared by header, main and footer.
func (p Page) width() string {
	if len(p.Sidebar) > 0 {
		return ""
	}
	if p.Wide {
		return "max-w-screen-2xl"
	}
	return "max-w-7xl"
}

func (p Page) mainClass() string {
	if p.Wide {
		return "mx-auto w-full max-w-screen-2xl flex-1 space-y-4 px-3 py-4"
	}
	return "mx-auto w-full max-w-7xl flex-1 space-y-6 px-4 py-6"
}

type NavItem struct {
	Key, Label, Href string
	// Hint is a small badge after the label (e.g. the wallet mode), coloured by Tone.
	Hint, Tone string
	// Current marks the selected item when Page.Active is not enough (e.g.
	// the selected wallet); Disabled shows a placeholder without a link.
	Current, Disabled bool
}

func (p Page) current(n NavItem) string {
	return Current(n.Current || (n.Key != "" && n.Key == p.Active))
}

const navLink = "rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-on-surface aria-[current=page]:bg-badge aria-[current=page]:text-on-badge"
const sideLink = "flex items-center justify-between gap-2 " + navLink

templ Shell(p Page) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } · { p.Brand }</title>
			<link rel="stylesheet" href={ Asset("app.css") }/>
			<script src={ Asset("theme-init.js") }></script>
			<script src={ Asset("htmx.min.js") }></script>
			if p.Charts {
				<script src={ Asset("lightweight-charts.js") } defer></script>
			}
			<script src={ Asset("app.js") } defer></script>
			<script src={ Asset("alpine.csp.min.js") } defer></script>
		</head>
		<body class="flex min-h-screen flex-col bg-page font-sans text-sm text-on-surface antialiased" hx-boost="true">
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-on-primary">Lewati ke konten</a>
			<header class="sticky top-0 z-30 border-b border-outline bg-surface/95 backdrop-blur" x-data="menu">
				<div class={ "mx-auto flex items-center gap-4 px-4 py-3 " + p.width() }>
					<span class="flex items-center gap-2 font-semibold">
						<span class="grid size-8 place-items-center rounded-lg bg-primary text-on-primary">
							@Icon("chart")
						</span>
						{ p.Brand }
					</span>
					if len(p.Sidebar) == 0 {
						<nav class="hidden items-center gap-1 md:flex" aria-label="Utama">
							for _, n := range p.Nav {
								<a href={ templ.SafeURL(n.Href) } class={ navLink } aria-current={ Current(n.Key == p.Active) }>{ n.Label }</a>
							}
						</nav>
					}
					<div class="ml-auto flex items-center gap-2">
						if p.Currency {
							@CurrencyToggle()
						}
						@ThemeToggle()
						<button type="button" class="grid size-9 place-items-center rounded-lg text-on-surface hover:bg-surface-alt md:hidden" x-on:click="toggle" aria-label="Menu">
							@Icon("menu")
						</button>
					</div>
				</div>
				<nav class="max-h-[80vh] overflow-y-auto border-t border-outline px-4 py-2 md:hidden" x-show="open" x-cloak aria-label="Utama (seluler)">
					if len(p.Sidebar) > 0 {
						@sideMenu(p)
					} else {
						<div class="flex flex-col gap-1">
							for _, n := range p.Nav {
								<a href={ templ.SafeURL(n.Href) } class={ navLink } aria-current={ Current(n.Key == p.Active) }>{ n.Label }</a>
							}
						</div>
					}
				</nav>
			</header>
			if len(p.Sidebar) > 0 {
				<div class="flex flex-1">
					<aside class="hidden w-60 shrink-0 border-r border-outline bg-surface md:block">
						<nav class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto p-3" aria-label="Menu">
							@sideMenu(p)
						</nav>
					</aside>
					<main id="main" class={ "min-w-0 " + p.mainClass() }>
						{ children... }
					</main>
				</div>
			} else {
				<main id="main" class={ p.mainClass() }>
					{ children... }
				</main>
			}
			<footer class="bg-footer text-on-footer">
				<div class={ "mx-auto flex flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs " + p.width() }>
					<span>{ p.Brand }</span>
					<span class="opacity-80">{ p.Footer }</span>
				</div>
			</footer>
			if p.Notice != "" {
				<div hidden data-toast={ p.Notice } data-toast-tone={ p.NoticeTone }></div>
			}
			@ConfirmDialog()
			@Toast()
		</body>
	</html>
}

templ sideMenu(p Page) {
	<div class="flex flex-col gap-1">
		for _, g := range p.Sidebar {
			if g.Collapsible {
				<details class="group" open?={ g.Open }>
					<summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-on-surface hover:bg-surface-alt [&::-webkit-details-marker]:hidden">
						<span>{ g.Title }</span>
						<span class="text-muted transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
					</summary>
					<div class="mb-1 ml-3 flex flex-col gap-0.5 border-l border-outline pl-2">
						for _, n := range g.Items {
							@sideItem(p, n)
						}
					</div>
				</details>
			} else {
				if g.Title != "" {
					<p class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-muted">{ g.Title }</p>
				}
				for _, n := range g.Items {
					@sideItem(p, n)
				}
			}
		}
		if p.SideFoot != nil {
			<div class="mt-2 border-t border-outline pt-2">
				@p.SideFoot
			</div>
		}
	</div>
}

templ sideItem(p Page, n NavItem) {
	if n.Disabled {
		<span class={ sideLink + " cursor-not-allowed opacity-60 hover:text-muted" } aria-disabled="true">
			<span>{ n.Label }</span>
			if n.Hint != "" {
				@Badge(n.Hint, n.Tone)
			}
		</span>
	} else {
		<a href={ templ.SafeURL(n.Href) } class={ sideLink } aria-current={ p.current(n) }>
			<span>{ n.Label }</span>
			if n.Hint != "" {
				@Badge(n.Hint, n.Tone)
			}
		</a>
	}
}

// CurrencyToggle picks the fiat shown under USDT amounts (stored in the browser).
templ CurrencyToggle() {
	<button
		type="button"
		x-data="fiat"
		x-on:click="toggle"
		x-text="label"
		title="Tampilkan nilai dalam rupiah atau dolar"
		class={ BtnSecondary + BtnSmall + " !px-2.5 tabular-nums" }
	>IDR</button>
}

templ ThemeToggle() {
	<button
		type="button"
		x-data="theme"
		x-on:click="cycle"
		x-bind:aria-label="label"
		x-bind:title="label"
		class="grid size-9 place-items-center rounded-lg text-on-surface hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
	>
		<span x-show="isSystem">@Icon("computer")</span>
		<span x-show="isLight" x-cloak>@Icon("sun")</span>
		<span x-show="isDark" x-cloak>@Icon("moon")</span>
	</button>
}

// ConfirmDialog is driven by data-confirm / data-confirm-body / data-confirm-label /
// data-confirm-tone="danger" on any htmx-issued form or button (see app.js).
templ ConfirmDialog() {
	<div
		x-data="confirmDialog"
		x-show="open"
		x-cloak
		x-on:confirm-ask.window="ask"
		x-on:keydown.escape.window="close"
		class="fixed inset-0 z-50 grid place-items-center p-4"
		role="dialog"
		aria-modal="true"
		aria-labelledby="confirm-title"
	>
		<div class="absolute inset-0 bg-footer/60" x-on:click="close"></div>
		<div class="relative w-full max-w-md rounded-xl border border-outline bg-surface p-6 shadow-xl">
			<h2 id="confirm-title" class="text-base font-semibold" x-text="title"></h2>
			<p class="mt-2 whitespace-pre-line text-muted" x-text="body"></p>
			<div class="mt-6 flex justify-end gap-2">
				<button type="button" x-ref="cancel" x-on:click="close" class={ BtnSecondary }>Batal</button>
				<button type="button" x-on:click="accept" x-bind:class="okClass" x-text="label"></button>
			</div>
		</div>
	</div>
}

templ Toast() {
	<div x-data="toast" x-on:toast.window="show" class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4" aria-live="assertive">
		<div x-show="shown" x-cloak x-bind:class="frame" class="pointer-events-auto flex max-w-md items-start gap-3 rounded-lg border bg-surface px-4 py-3 shadow-lg">
			<span x-show="isPos" class="text-pos">@Icon("check")</span>
			<span x-show="isNeg" class="text-neg">@Icon("warn")</span>
			<span x-text="message"></span>
			<button type="button" x-on:click="hide" class="text-muted hover:text-on-surface" aria-label="Tutup">@Icon("x")</button>
		</div>
	</div>
}
