package ui

// Page describes the shell around a surface (bot dashboard, managed, catalyst).
type Page struct {
	Title  string
	Brand  string
	Active string
	Nav    []NavItem
	Footer string
	// Charts loads lightweight-charts; only pages with data-chart elements need it.
	Charts bool
	// Wide uses the full screen width (trading screen).
	Wide bool
}

// width is the content width shared by header, main and footer.
func (p Page) width() string {
	if p.Wide {
		return "max-w-screen-2xl"
	}
	return "max-w-7xl"
}

func (p Page) mainClass() string {
	if p.Wide {
		return "mx-auto w-full max-w-screen-2xl flex-1 space-y-4 px-3 py-4"
	}
	return "mx-auto w-full max-w-7xl flex-1 space-y-6 px-4 py-6"
}

type NavItem struct {
	Key, Label, Href string
}

const navLink = "rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-on-surface aria-[current=page]:bg-badge aria-[current=page]:text-on-badge"

templ Shell(p Page) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } · { p.Brand }</title>
			<link rel="stylesheet" href={ Asset("app.css") }/>
			<script src={ Asset("theme-init.js") }></script>
			<script src={ Asset("htmx.min.js") }></script>
			if p.Charts {
				<script src={ Asset("lightweight-charts.js") } defer></script>
			}
			<script src={ Asset("app.js") } defer></script>
			<script src={ Asset("alpine.csp.min.js") } defer></script>
		</head>
		<body class="flex min-h-screen flex-col bg-page font-sans text-sm text-on-surface antialiased" hx-boost="true">
			<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-3 focus:py-2 focus:text-on-primary">Lewati ke konten</a>
			<header class="sticky top-0 z-30 border-b border-outline bg-surface/95 backdrop-blur" x-data="menu">
				<div class={ "mx-auto flex items-center gap-4 px-4 py-3 " + p.width() }>
					<span class="flex items-center gap-2 font-semibold">
						<span class="grid size-8 place-items-center rounded-lg bg-primary text-on-primary">
							@Icon("chart")
						</span>
						{ p.Brand }
					</span>
					<nav class="hidden items-center gap-1 md:flex" aria-label="Utama">
						for _, n := range p.Nav {
							<a href={ templ.SafeURL(n.Href) } class={ navLink } aria-current={ Current(n.Key == p.Active) }>{ n.Label }</a>
						}
					</nav>
					<div class="ml-auto flex items-center gap-2">
						@ThemeToggle()
						<button type="button" class="grid size-9 place-items-center rounded-lg text-on-surface hover:bg-surface-alt md:hidden" x-on:click="toggle" aria-label="Menu">
							@Icon("menu")
						</button>
					</div>
				</div>
				<nav class="border-t border-outline px-4 py-2 md:hidden" x-show="open" x-cloak aria-label="Utama (seluler)">
					<div class="flex flex-col gap-1">
						for _, n := range p.Nav {
							<a href={ templ.SafeURL(n.Href) } class={ navLink } aria-current={ Current(n.Key == p.Active) }>{ n.Label }</a>
						}
					</div>
				</nav>
			</header>
			<main id="main" class={ p.mainClass() }>
				{ children... }
			</main>
			<footer class="bg-footer text-on-footer">
				<div class={ "mx-auto flex flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs " + p.width() }>
					<span>{ p.Brand }</span>
					<span class="opacity-80">{ p.Footer }</span>
				</div>
			</footer>
			@ConfirmDialog()
			@Toast()
		</body>
	</html>
}

templ ThemeToggle() {
	<button
		type="button"
		x-data="theme"
		x-on:click="cycle"
		x-bind:aria-label="label"
		x-bind:title="label"
		class="grid size-9 place-items-center rounded-lg text-on-surface hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
	>
		<span x-show="isSystem">@Icon("computer")</span>
		<span x-show="isLight" x-cloak>@Icon("sun")</span>
		<span x-show="isDark" x-cloak>@Icon("moon")</span>
	</button>
}

// ConfirmDialog is driven by data-confirm / data-confirm-body / data-confirm-label /
// data-confirm-tone="danger" on any htmx-issued form or button (see app.js).
templ ConfirmDialog() {
	<div
		x-data="confirmDialog"
		x-show="open"
		x-cloak
		x-on:confirm-ask.window="ask"
		x-on:keydown.escape.window="close"
		class="fixed inset-0 z-50 grid place-items-center p-4"
		role="dialog"
		aria-modal="true"
		aria-labelledby="confirm-title"
	>
		<div class="absolute inset-0 bg-footer/60" x-on:click="close"></div>
		<div class="relative w-full max-w-md rounded-xl border border-outline bg-surface p-6 shadow-xl">
			<h2 id="confirm-title" class="text-base font-semibold" x-text="title"></h2>
			<p class="mt-2 whitespace-pre-line text-muted" x-text="body"></p>
			<div class="mt-6 flex justify-end gap-2">
				<button type="button" x-ref="cancel" x-on:click="close" class={ BtnSecondary }>Batal</button>
				<button type="button" x-on:click="accept" x-bind:class="okClass" x-text="label"></button>
			</div>
		</div>
	</div>
}

templ Toast() {
	<div x-data="toast" x-on:toast.window="show" class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4" aria-live="assertive">
		<div x-show="shown" x-cloak class="pointer-events-auto flex max-w-md items-start gap-3 rounded-lg border border-outline bg-surface px-4 py-3 shadow-lg">
			<span class="text-neg">@Icon("warn")</span>
			<span x-text="message"></span>
			<button type="button" x-on:click="hide" class="text-muted hover:text-on-surface" aria-label="Tutup">@Icon("x")</button>
		</div>
	</div>
}
