[Unit]
Description=Check P3 runtime, research, budget and local backup freshness
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/trading-bot-catalyst/repo
ExecStart=/usr/bin/python3 /opt/trading-bot-catalyst/repo/deploy/catalyst-observe.py
UMask=0077
Nice=10
CPUQuota=10%
MemoryMax=128M
TimeoutStartSec=90
