[Unit]
Description=Back up ana-core database and configuration only
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ana-core/repo
ExecStart=/usr/bin/bash /opt/ana-core/repo/deploy/vps-backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=128M
TimeoutStartSec=15min
