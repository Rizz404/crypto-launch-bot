# Copy to .env.vps at the repository root ONCE. Keep it out of Git.
# Use the exact ghcr.io/rizz404/trading-bot@sha256:... from the Actions summary.
BOT_IMAGE=
TB_APP__MODE=paper

# Generate three different passwords. For the database, use URL-safe hex:
# openssl rand -hex 24
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
TB_WEB__PASSWORD=

# Optional until Telegram is configured in configs/config.yaml.
TB_TELEGRAM__TOKEN=

# Only needed for mode testnet; paper uses public mainnet prices.
TB_EXCHANGES__BINANCE__API_KEY=
TB_EXCHANGES__BINANCE__API_SECRET=

# Bind ports to server loopback; access through an SSH tunnel.
BOT_WEB_PORT=18080
BOT_METRICS_PORT=19100
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
